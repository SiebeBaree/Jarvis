# ── Database (NeonDB Postgres) ─────────────────────────────────────────────
# Neon pooled connection string; `main` branch = prod, `dev` branch = local dev
DATABASE_URL=

# ── Auth ───────────────────────────────────────────────────────────────────
# Random secret concatenated into the password pre-hash (defense in depth)
AUTH_PEPPER=

# ── Vercel Blob (progress photos, Stage 4) ─────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── AI (Stage 2+) — all model config is env-driven, nothing hardcoded ──────
AI_BASE_URL=https://api.openai.com/v1
AI_AUTH_MODE=api_key            # api_key | codex_oauth (experiment)
OPENAI_API_KEY=
AI_MODEL_DEEP=gpt-5.6-luna      # verified 2026-07-10 (no mini variant exists)
AI_MODEL_FAST=gpt-5.6-luna      # same model, lower reasoning effort
AI_EFFORT_DEEP=high
AI_EFFORT_FAST=low
# Codex-subscription experiment only (AI_AUTH_MODE=codex_oauth):
AI_CODEX_ACCESS_TOKEN=
AI_CODEX_REFRESH_TOKEN=
